# Copy this file to ".env" and put your real key(s) below. Never commit .env.
# You only need the key for the provider set in settings.yaml.

# Gemini: create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here

# OpenAI: create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here
